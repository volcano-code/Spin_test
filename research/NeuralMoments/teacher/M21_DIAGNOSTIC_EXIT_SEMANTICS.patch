+def verified_pilot_label(exit_code, record, spec):
+    """Accept a numeric diagnostic, while preserving the explicit W0 exclusion.
+
+    run_native_smoke intentionally exits 2 when a valid physical-moment label
+    carries the W0/solid-proof exclusion reason. This is distinct from a
+    numerical failure. The sealed label, request identity, exact ten-moment
+    comparison and expected exclusion string must all agree.
+    """
+    if not isinstance(record,dict) or not isinstance(spec,dict): return False
+    if set(record)!={'payload','payload_sha256','identity'}: return False
+    payload=record.get('payload'); identity=record.get('identity')
+    if not isinstance(payload,dict) or not isinstance(identity,dict): return False
+    try:
+        if _canonical_digest(payload)!=record.get('payload_sha256'): return False
+        expected_q=spec.get('native_c')
+        expected_model=spec.get('expected_model_sha256')
+        expected_module=spec.get('expected_native_module_sha256')
+        if not isinstance(expected_q,list) or len(expected_q)!=10: return False
+        if payload.get('schema')!='w2-cherchi-teacher-v2-pre-w0': return False
+        if payload.get('order')!=TEACHER_ORDER or payload.get('native_c_order')!=NATIVE_C_ORDER: return False
+        if payload.get('coefficient_convention')!=COEFFICIENT_CONVENTION: return False
+        if payload.get('q')!=expected_q or payload.get('native_c')!=expected_q: return False
+        expected_poly=expected_q[:7]+[2.0*float(x) for x in expected_q[7:]]
+        if payload.get('polynomial_q')!=expected_poly: return False
+        if payload.get('model_sha256')!=expected_model or payload.get('native_module_sha256')!=expected_module: return False
+        if identity.get('q_sha256')!=_canonical_digest(expected_q): return False
+        if identity.get('geometry_sha256')!=_canonical_digest(payload.get('geometry')): return False
+        if identity.get('model_sha256')!=expected_model or identity.get('native_module_sha256')!=expected_module: return False
+        for key in ('r_D','r_F'):
+            values=payload.get(key)
+            if not isinstance(values,list) or len(values)!=10: return False
+            if any(type(x) not in (int,float) or not math.isfinite(x) for x in values): return False
+        proof=payload.get('exact_proof')
+        if not isinstance(proof,dict) or proof.get('kind')!='cherchi_same_call_discrete_map': return False
+        audit=proof.get('independent_ten_moment_audit')
+        comparison=audit.get('comparison') if isinstance(audit,dict) else None
+        if (proof.get('native_cherchi') is not True or proof.get('same_call_attachment') is None
+                or not isinstance(comparison,dict) or comparison.get('within_tolerance') is not True): return False
+        if (payload.get('topology_status')!='OBSERVED_DISCRETE_MAP' or payload.get('derivative_status')!='UNKNOWN'
